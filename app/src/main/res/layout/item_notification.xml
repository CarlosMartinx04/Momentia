<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_unread"
    android:layout_marginBottom="8dp"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivPostThumb"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:backgroundTint="@null"
        android:background="@drawable/bg_circle_photo"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/viewUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_add"
        android:layout_marginStart="46dp"
        android:layout_marginTop="-2dp"
        app:layout_constraintTop_toTopOf="@id/ivPostThumb"
        app:layout_constraintStart_toStartOf="@id/ivPostThumb" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Prueba"
        app:layout_constraintTop_toTopOf="@id/ivPostThumb"
        app:layout_constraintBottom_toTopOf="@id/tvType"
        app:layout_constraintStart_toEndOf="@id/ivPostThumb"
        app:layout_constraintEnd_toStartOf="@id/tvTime" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        android:text="Prueba"
        app:layout_constraintTop_toTopOf="@id/ivPostThumb"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:layout_marginStart="12dp"
        android:text="Prueba"
        app:layout_constraintTop_toBottomOf="@id/tvMessage"
        app:layout_constraintStart_toEndOf="@id/ivPostThumb"
        app:layout_constraintBottom_toBottomOf="@id/ivPostThumb" />

</androidx.constraintlayout.widget.ConstraintLayout>